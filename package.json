{
  "name": "bbctrl",
  "version": "1.6.7",
  "homepage": "https://onefinitycnc.com/",
  "repository": "https://github.com/OneFinityCNC/onefinity",
  "license": "GPL-3.0+",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "postinstall": "cd src/svelte-components && npm ci",
    "prepare": "husky",
    "test": "vitest run",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@vitest/ui": "^5.0.2",
    "browserify": "^17.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.4.0",
    "eslint-plugin-promise": "^7.3.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "inquirer": "^14.2.2",
    "jshint": "^2.13.6",
    "jstransformer-escape-html": "^1.1.0",
    "jstransformer-scss": "^2.0.0",
    "jstransformer-stylus": "^1.5.0",
    "lint-staged": "^17.6.0",
    "lodash.merge": "4.6.2",
    "neostandard": "^0.13.0",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.9",
    "pug-cli": "1.0.0-alpha6",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{cjs,cts,js,mjs,mts,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,scss}": [
      "prettier --write"
    ]
  }
